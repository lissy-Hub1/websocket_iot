# Copia este archivo a .env y completa los valores. NUNCA subas .env a GitHub.
DB_HOST=tu-instancia.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=vehiculo_iot
DB_USER=usuario_de_la_api
DB_PASSWORD=cambia_esto
DB_CONNECT_TIMEOUT=5
# Genera una clave nueva:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=cambia_esto
# Opcional (recomendado): cifrar EC2 -> RDS con el bundle de CA de RDS
# DB_SSL_CA=/home/ubuntu/global-bundle.pem
